{
  "name": "@aether/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aether Brain desktop shell (Electron): pick a vault folder, watch it, render the 3D brain.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "start": "pnpm build:main && electron .",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@aether/core": "workspace:*",
    "@aether/graph": "workspace:*",
    "@aether/ui": "workspace:*",
    "chokidar": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
